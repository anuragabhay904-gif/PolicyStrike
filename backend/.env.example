# Environment Configuration Example
# Copy to .env or set in your hosting platform (Render/Railway/Vercel)

# Payment Mode: Set to DEMO for simulated Razorpay links, or RAZORPAY for real test mode
PAYMENT_MODE=DEMO

# Razorpay Test Mode Credentials (Required only when PAYMENT_MODE=RAZORPAY)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere

# Google Gemini API Key (For autonomous contextual explanations & outreach messaging)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.0-flash

# Server Port & CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL (Production deployment only)
# DATABASE_URL=jdbc:postgresql://your-host:5432/your-db
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your-password
